# CyberLaw Atlas — Environment Template

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cyberlaw_atlas?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cyberlaw_atlas?schema=public"

# AI Service Configuration
# Options: "mock" (built-in legal intelligence fallback), "gemini", "openai", "groq", "anthropic", "ollama"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# External Search Configuration
# Options: "mock" (internal gazette & statute search), "tavily", "brave", "serpapi"
SEARCH_PROVIDER="mock"
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""
SERPAPI_API_KEY=""

# Application Security
NEXTAUTH_SECRET="dev-cyberlaw-secret-key-32-chars-minimum-needed"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_ACCESS_KEY="admin123"
